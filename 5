
#include <stdio.h>
#include <math.h>
/* 5 */
int main() {
    float x = 0, y = 0;
    printf("Print X: ");
    scanf("%f", &x);
    printf("Print Y: ");
    scanf("%f", &y);
    if ((x >= -1) && (x <= 1) && (y >= -1) && (y <= 1) && ((x + y) >= 0)) {
        printf("YES\n");
    } else {
        printf("NO\n");
    }

    return 0;
}

